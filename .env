# ───────────── دیتابیس (PostgreSQL روی VPS) ─────────────
# اگه از طریق SSH tunnel وصل می‌شی (مثلاً: ssh -N -L 5433:localhost:5432 user@vps) همین localhost:5433 درسته.
# اگه مستقیم به IP سرور وصل می‌شی حتماً ?sslmode=require اضافه کن و پورت 5432 رو فقط برای IP خودت باز کن.
DATABASE_URL="postgresql://sopermarket_user:Matint_87@46.249.98.230:5432/sopermarket"

# ───────────── احراز هویت ─────────────
# کلید امضای JWT — حداقل ۳۲ کاراکتر، تصادفی، و هیچ‌وقت توی git نره. برای ساختنش:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (توی سرور production یه کلید «جدا» بساز؛ با عوض‌کردنش همه از حساب‌شون بیرون می‌افتن.)
AUTH_SECRET="qBXuOtT6ldniim-tDXpcfk2CuUtwXE4hAEuiWMrEDalh0dpxcRopBWVgyxZ_aARJ"

# ───────────── پیامک OTP ─────────────
# console   → فقط توسعه: کد توی ترمینال چاپ می‌شه و توی صفحه‌ی ورود هم نشون داده می‌شه (پیامکی نمی‌ره)
# kavenegar → ارسال واقعی با «Verify Lookup» کاوه‌نگار
SMS_PROVIDER="console"
# فقط برای kavenegar: توی پنل کاوه‌نگار یه الگو (template) بساز که متنش «%token» داشته باشه
# مثلاً: «کد ورود شما به سوپرمارکت صبحنگار: %token»
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# ───────────── نقشه و آدرس (اختیاری) ─────────────
# سرور تبدیل مختصات به آدرس (سازگار با Nominatim). پیش‌فرض: سرور عمومی OpenStreetMap (فقط برای ترافیک کم)
# GEOCODE_URL="https://nominatim.openstreetmap.org/reverse"
# GEOCODE_USER_AGENT="sopermarket-shop/1.0 (you@example.com)"
# کاشی‌های نقشه. برای production یه سرویس مناسب یا سرور خودت رو بذار (NEXT_PUBLIC یعنی توی مرورگر هم دیده می‌شه)
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap"
